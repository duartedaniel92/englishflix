# Copie para .env.local (que fica fora do Git) e preencha.
# Local: rode `npx supabase status` e copie a URL e as chaves.

# URL do projeto Supabase. Local: http://127.0.0.1:54321. Fora da máquina, só https.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave publicável (sb_publishable_...). Vai para o navegador: nunca coloque a chave secreta aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...). Só no servidor; nunca em variável NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
