# Copie para .env.local (que fica fora do Git) e preencha.
# Desenvolvimento: URL e chaves do projeto Supabase de dev (painel do Supabase → Project Settings → API).

# URL do projeto Supabase (https://<projeto>.supabase.co). http só é aceito para Supabase local.
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (sb_publishable_...). Vai para o navegador: nunca coloque a chave secreta aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...). Só no servidor; nunca em variável NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
